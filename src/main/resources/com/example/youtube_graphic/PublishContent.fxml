<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="600" prefWidth="800"
            style="-fx-background-color: #121212;"
            xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.youtube_graphic.PublishContentPanel">

    <!-- Title -->
    <Label layoutX="30" layoutY="30"
           style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #29c46a;"
           text="🆕 Publish New Content" />

    <!-- Content Type -->
    <Label layoutX="30" layoutY="90" text="🎬 Content Type:" style="-fx-text-fill: white;" />
    <ComboBox fx:id="contentTypeComboBox" layoutX="150" layoutY="90"
              onAction="#updateVisibleFields" prefWidth="300" />

    <!-- Title -->
    <Label layoutX="30" layoutY="140" text="📝 Title:" style="-fx-text-fill: white;" />
    <TextField fx:id="titleField" layoutX="150" layoutY="140" prefWidth="300" />

    <!-- Description -->
    <Label layoutX="30" layoutY="190" text="📄 Description:" style="-fx-text-fill: white;" />
    <TextArea fx:id="descriptionField" layoutX="150" layoutY="190" prefHeight="60" prefWidth="300" />

    <!-- Duration -->
    <Label layoutX="30" layoutY="270" text="⌛ Duration (hh:mm:ss):" style="-fx-text-fill: white;" />
    <TextField fx:id="durationField" layoutX="150" layoutY="270" prefWidth="300" />

    <!-- File Link -->
    <Label layoutX="30" layoutY="320" text="📁 File Link:" style="-fx-text-fill: white;" />
    <TextField fx:id="fileLinkField" layoutX="150" layoutY="320" prefWidth="250" />
    <Button layoutX="410" layoutY="320" onAction="#chooseFile" text="Choose" />

    <!-- Cover Link -->
    <Label layoutX="30" layoutY="370" text="📷 Cover Link:" style="-fx-text-fill: white;" />
    <TextField fx:id="coverLinkField" layoutX="150" layoutY="370" prefWidth="250" />
    <Button layoutX="410" layoutY="370" onAction="#chooseCover" text="Choose" />

    <!-- Category -->
    <Label layoutX="30" layoutY="420" text="️#Category:" style="-fx-text-fill: white;" />
    <ComboBox fx:id="categoryComboBox" layoutX="150" layoutY="420" prefWidth="300" />

    <!-- Exclusive -->
    <Label layoutX="30" layoutY="470" text="🔒 Is Exclusive?" style="-fx-text-fill: white;" />
    <CheckBox fx:id="isExclusiveCheckBox" layoutX="150" layoutY="470" />

    <!-- Optional Fields -->
    <Label layoutX="500" layoutY="90" text="📜 Subtitles:" style="-fx-text-fill: white;" />
    <TextField fx:id="subtitlesField" layoutX="600" layoutY="90" prefWidth="150" />

    <Label layoutX="500" layoutY="140" text="🎵 Reference Music:" style="-fx-text-fill: white;" />
    <TextField fx:id="referenceMusicField" layoutX="600" layoutY="140" prefWidth="150" />

    <Label layoutX="500" layoutY="190" text="🕓 Scheduled Time:" style="-fx-text-fill: white;" />
    <TextField fx:id="scheduledTimeField" layoutX="600" layoutY="190" prefWidth="150" />
    <Label layoutX="500.0" layoutY="207.0" text="(YYYY-MM-DD)" style="-fx-text-fill: gray;" />

    <Label layoutX="500" layoutY="240" text="📶 Quality:" style="-fx-text-fill: white;" />
    <ComboBox fx:id="qualityComboBox" layoutX="600" layoutY="240" prefWidth="150" />

    <Label layoutX="500" layoutY="290" text="💾 Format:" style="-fx-text-fill: white;" />
    <ComboBox fx:id="formatComboBox" layoutX="600" layoutY="290" prefWidth="150" />

    <!-- Action Buttons -->
    <Button layoutX="600" layoutY="400" text="🚀 Publish Content"
            style="-fx-background-color: #1f1f1f; -fx-text-fill: white; -fx-background-radius: 5;"
            onAction="#onPublishContent" />

    <Button layoutX="600" layoutY="450" text="🔙 Back"
            style="-fx-background-color: #1f1f1f; -fx-text-fill: white; -fx-background-radius: 5;"
            onAction="#onBack" />
</AnchorPane>
