<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.Group?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="633.0" prefWidth="900.0"
            style="-fx-background-color: #ccc7c7;"
            xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.youtube_graphic.LibraryPanel">

   <children>
      <Group layoutX="150.0" layoutY="30.0">

         <!-- Profiling & Account Info -->
         <ImageView fx:id="profileCover"
                    fitHeight="150.0" fitWidth="154.0"
                    layoutX="166.0" pickOnBounds="true" preserveRatio="true"/>
         <Label layoutX="10.0" layoutY="205.0" text="Username :" textFill="#29c46a"/>
         <Label fx:id="username" layoutX="90.0" layoutY="205.0"/>

         <Label layoutX="10.0" layoutY="266.0" text="Fullname :" textFill="#29c46a"/>
         <Label fx:id="fullName" layoutX="90.0" layoutY="266.0"/>

         <Label layoutX="10.0" layoutY="324.0" text="Email :" textFill="#29c46a"/>
         <Label fx:id="email" layoutX="90.0" layoutY="324.0"/>

         <Label layoutX="10.0" layoutY="349.0" text="PhoneNumber :" textFill="#29c46a"/>
         <Label fx:id="phoneNumber" layoutX="110.0" layoutY="349.0"/>

         <Label layoutX="10.0" layoutY="375.0" text="Credit :" textFill="#29c46a"/>
         <Label fx:id="balance" layoutX="90.0" layoutY="375.0"/>

         <!-- Edit buttons -->
         <Button fx:id="changePasswordBtn" layoutX="9.0" layoutY="226.0"
                 onMouseClicked="#changePasswordClicked" text="Change Password"/>
         <Button fx:id="changeFullnameBtn" layoutX="10.0" layoutY="292.0"
                 onMouseClicked="#changeFullnameClicked" text="Change Fullname"/>

         <!-- Subscription -->
         <Label layoutX="10.0" layoutY="434.0" text="Subscription Type :" textFill="#29c46a"/>
         <Label fx:id="subscriptionType" layoutX="140.0" layoutY="434.0"/>
         <Button fx:id="getPremiumBtn" layoutX="10.0" layoutY="459.0"
                 onMouseClicked="#getPremiumClicked" text="Get Premium"/>

         <!-- Increase credits -->
         <Button fx:id="inccreaseCreditBtn" layoutX="10.0" layoutY="396.0"
                 onMouseClicked="#increaseCreditClicked" text="Increase Credit"/>

         <!-- Channel info -->
         <Label layoutX="380.0" layoutY="180.0" text="Your Channel" textFill="#29c46a"/>
         <ImageView fx:id="channelCover" fitHeight="67.0" fitWidth="95.0"
                    layoutX="380.0" layoutY="210.0" onMouseClicked="#channelCoverClicked"
                    pickOnBounds="true" preserveRatio="true"/>
         <Button fx:id="createChannelBtn" layoutX="380.0" layoutY="304.0"
                 onMouseClicked="#createChannelClicked" text="Create Channel"/>

         <!-- Playlists -->
         <Label layoutX="380.0" layoutY="366.0" text="Your Playlists" textFill="#29c46a"/>
         <Button fx:id="createPlaylistBtn" layoutX="380.0" layoutY="390.0"
                 onMouseClicked="#createPlaylistClicked" text="Create Playlist"/>
         <ListView fx:id="playlistListView"
                   layoutX="380.0" layoutY="430.0"
                   prefWidth="250.0" prefHeight="150.0"
                   onMouseClicked="#playlistSelected"/>

         <!-- Logout -->
         <Button fx:id="logoutBtn" layoutX="250.0" layoutY="500.0"
                 onMouseClicked="#logoutClicked" text="Logout"/>

      </Group>
   </children>
</AnchorPane>
