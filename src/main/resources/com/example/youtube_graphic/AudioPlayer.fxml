<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>


<AnchorPane prefHeight="700.0" prefWidth="1000.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.youtube_graphic.AudioPlayerPanel">
   <children>
      <Button fx:id="backBtn" layoutX="30.0" layoutY="30.0" onAction="#backClicked" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-size: 14px; -fx-background-radius: 8px;" text="← Back" />
      <VBox layoutX="660.0" layoutY="80.0" spacing="8.0">
         <children>
            <Label fx:id="videoNameLabel" style="-fx-font-size: 18px; -fx-font-weight: bold;" />
            <Label fx:id="descriptionLabel" style="-fx-font-size: 14px;" wrapText="true" />
            <Label fx:id="durationLabel" style="-fx-font-size: 14px;" />
            <Label fx:id="categoryLabel" style="-fx-font-size: 14px;" />
            <Label fx:id="viewsLabel" style="-fx-font-size: 14px;" />
            <Label fx:id="likesLabel" style="-fx-font-size: 14px;" />
         </children>
      </VBox>
      <HBox layoutX="40.0" layoutY="460.0" spacing="15.0">
         <children>
            <Button fx:id="playBtn" onMouseClicked="#playClicked" text="▶ Play" />
            <Button fx:id="pauseBtn" onMouseClicked="#pauseClicked" text="⏸ Pause" />
            <Button fx:id="stopBtn" onMouseClicked="#stopClicked" text="⏹ Stop" />
            <Slider fx:id="audioSlider" prefWidth="120.0" />
         </children>
      </HBox>
      <Slider fx:id="videoSlider" layoutX="40.0" layoutY="510.0" prefWidth="600.0" />
      <Label fx:id="timeLabel" layoutX="650.0" layoutY="510.0" text="00:00 / 00:00" />
      <HBox layoutX="40.0" layoutY="560.0" spacing="20.0">
         <children>
            <Button fx:id="likeBtn" onAction="#likeClicked" text="❤️ Like" />
            <Button fx:id="reportBtn" onAction="#reportClicked" text="🚩 Report" />
         </children>
      </HBox>
      <VBox layoutX="40.0" layoutY="610.0" spacing="8.0">
         <children>
            <TextArea fx:id="commentTextArea" prefHeight="50.0" prefWidth="400.0" promptText="Write a comment..." />
            <Button fx:id="commentBtn" onAction="#commentClicked" text="Add Comment" />
         </children>
      </VBox>
      <ListView fx:id="commentListView" layoutX="725.0" layoutY="327.0" prefHeight="363.0" prefWidth="255.0" />
      <HBox layoutX="660.0" layoutY="260.0" spacing="10.0">
         <children>
            <ImageView fx:id="channelImageView" fitHeight="50.0" fitWidth="50.0" />
            <Label fx:id="channelNameLabel" />
         </children>
      </HBox>
      <ImageView fx:id="AudioView" fitHeight="350.0" fitWidth="600.0" layoutX="84.0" layoutY="85.0" pickOnBounds="true" preserveRatio="true" />
   </children>
</AnchorPane>
