<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="700.0" prefWidth="1000.0" style="-fx-background-color: #1e1e1e;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.youtube_graphic.AudioPlayerPanel">
   <children>
      <Button fx:id="backBtn" layoutX="30.0" layoutY="30.0" onAction="#backClicked"
              style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-size: 14px; -fx-background-radius: 8px;"
              text="← Back" />

      <VBox layoutX="660.0" layoutY="80.0" spacing="8.0">
         <children>
            <Label fx:id="videoNameLabel" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white;" />
            <Label fx:id="descriptionLabel" style="-fx-font-size: 14px; -fx-text-fill: lightgray;" wrapText="true" />
            <Label fx:id="durationLabel" style="-fx-font-size: 14px; -fx-text-fill: lightgray;" />
            <Label fx:id="categoryLabel" style="-fx-font-size: 14px; -fx-text-fill: lightgray;" />
            <Label fx:id="viewsLabel" style="-fx-font-size: 14px; -fx-text-fill: lightgray;" />
            <Label fx:id="likesLabel" style="-fx-font-size: 14px; -fx-text-fill: lightgray;" />
         </children>
      </VBox>

      <HBox layoutX="40.0" layoutY="460.0" spacing="15.0">
         <children>
            <Button fx:id="playBtn" onMouseClicked="#playClicked" text="▶ Play"
                    style="-fx-background-color: #2ecc71; -fx-text-fill: white;" />
            <Button fx:id="pauseBtn" onMouseClicked="#pauseClicked" text="⏸ Pause"
                    style="-fx-background-color: #f1c40f; -fx-text-fill: black;" />
            <Button fx:id="stopBtn" onMouseClicked="#stopClicked" text="⏹ Stop"
                    style="-fx-background-color: #e74c3c; -fx-text-fill: white;" />
            <Slider fx:id="audioSlider" prefWidth="120.0" style="-fx-control-inner-background: #333333;" />
         </children>
      </HBox>

      <Slider fx:id="videoSlider" layoutX="40.0" layoutY="510.0" prefWidth="600.0"
              style="-fx-control-inner-background: #333333;" />
      <Label fx:id="timeLabel" layoutX="650.0" layoutY="510.0" text="00:00 / 00:00" style="-fx-text-fill: white;" />

      <HBox layoutX="40.0" layoutY="560.0" spacing="20.0">
         <children>
            <Button fx:id="likeBtn" onAction="#likeClicked" text="👍 Like"
                    style="-fx-background-color: #2c3e50; -fx-text-fill: white;" />
            <Button fx:id="reportBtn" onAction="#reportClicked" text="⚠ Report"
                    style="-fx-background-color: #c0392b; -fx-text-fill: white;" />
         </children>
      </HBox>

      <VBox layoutX="40.0" layoutY="610.0" spacing="8.0">
         <children>
            <TextArea fx:id="commentTextArea" prefHeight="50.0" prefWidth="400.0" promptText="Write a comment..."
                      style="-fx-control-inner-background: #2c2c2c; -fx-text-fill: white;" />
            <Button fx:id="commentBtn" onAction="#commentClicked" text="Add Comment"
                    style="-fx-background-color: #2980b9; -fx-text-fill: white;" />
         </children>
      </VBox>

      <ListView fx:id="commentListView" layoutX="725.0" layoutY="327.0" prefHeight="363.0" prefWidth="255.0"
                style="-fx-control-inner-background: #2c2c2c; -fx-text-fill: white;" />

      <HBox layoutX="660.0" layoutY="260.0" spacing="10.0">
         <children>
            <ImageView fx:id="channelImageView" fitHeight="50.0" fitWidth="50.0" />
            <Label fx:id="channelNameLabel" style="-fx-text-fill: white;" />
         </children>
      </HBox>

      <ImageView fx:id="AudioView" fitHeight="350.0" fitWidth="600.0" layoutX="84.0" layoutY="85.0" pickOnBounds="true" preserveRatio="true" />
   </children>
</AnchorPane>
