<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Button?>

<BorderPane xmlns:fx="http://javafx.com/fxml" xmlns="http://javafx.com/javafx"
            fx:controller="com.example.youtube_graphic.BasePageController"
            prefWidth="900" prefHeight="600"
            style="-fx-background-color: #1e1e1e;">

    <left>
        <VBox spacing="10" style="-fx-background-color: #2c3e50; -fx-padding: 15;">
            <Button text="🏠 Home" onAction="#goToHome"
                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 14px;" />
            <Button text="📚 Library" onAction="#goToLibrary"
                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 14px;" />
            <Button text="📺 Subscriptions" onAction="#goToSubscriptions"
                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 14px;" />
            <Button text="👤 Channel" onAction="#goToChannel"
                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 14px;" />
        </VBox>
    </left>

    <center>
        <AnchorPane fx:id="mainContent" style="-fx-background-color: #2a2a2a;">
            <!-- محتوای صفحه‌ها اینجا بارگذاری می‌شود -->
        </AnchorPane>
    </center>

</BorderPane>
