<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Button?>

<BorderPane xmlns:fx="http://javafx.com/fxml" xmlns="http://javafx.com/javafx" fx:controller="com.example.youtube_graphic.BasePageController" prefWidth="900" prefHeight="600">

    <left>
        <VBox spacing="10" style="-fx-background-color: #2c3e50; -fx-padding: 10;">
            <Button text="Home" onAction="#goToHome" />
            <Button text="Library" onAction="#goToLibrary" />
            <Button text="Subscriptions" onAction="#goToSubscriptions" />
            <Button text="Channel" onAction="#goToChannel" />
        </VBox>
    </left>

    <center>
        <AnchorPane fx:id="mainContent" style="-fx-background-color: #ffffff;">
            <!-- محتوای صفحه ها اینجا بارگذاری میشود -->
        </AnchorPane>
    </center>

</BorderPane>
