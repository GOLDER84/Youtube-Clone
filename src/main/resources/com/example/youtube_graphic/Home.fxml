<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.FlowPane?>

<?import javafx.scene.control.ScrollPane?>
<AnchorPane prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="com.example.youtube_graphic.HomePanel">

    <children>

        <!-- Suggested Contents Label -->
        <Label layoutX="50.0" layoutY="20.0" text="Suggested Contents:" style="-fx-font-size: 20px;"/>

        <!-- ScrollPane برای Suggested -->
        <ScrollPane layoutX="50.0" layoutY="50.0" prefWidth="700.0" prefHeight="200.0" hbarPolicy="AS_NEEDED" vbarPolicy="AS_NEEDED">
            <content>
                <FlowPane fx:id="suggestedFlowPane" prefWidth="680.0" prefHeight="180.0" hgap="10" vgap="10" />
            </content>
        </ScrollPane>

        <!-- Search Field -->
        <TextField fx:id="searchField" layoutX="50.0" layoutY="280.0" promptText="Search content or channel..." prefWidth="500.0"/>

        <!-- Search Button -->
        <Button fx:id="searchBtn" layoutX="570.0" layoutY="280.0" text="Search" onAction="#searchClicked"/>

        <!-- Search Results Label -->
        <Label layoutX="50.0" layoutY="330.0" text="Search Results:" style="-fx-font-size: 20px;" />

        <!-- ScrollPane برای Search Results -->
        <ScrollPane layoutX="50.0" layoutY="360.0" prefWidth="700.0" prefHeight="200.0" hbarPolicy="AS_NEEDED" vbarPolicy="AS_NEEDED">
            <content>
                <FlowPane fx:id="searchResultsFlowPane" prefWidth="680.0" prefHeight="180.0" hgap="10" vgap="10" />
            </content>
        </ScrollPane>

    </children>
</AnchorPane>
