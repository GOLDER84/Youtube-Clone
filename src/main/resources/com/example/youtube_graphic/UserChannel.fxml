<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="600.0" prefWidth="800.0"
            xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.youtube_graphic.UserChannelPanel"
            style="-fx-background-color: #121212;">

    <!-- Header -->
    <Label layoutX="20.0" layoutY="20.0" text="📺 My Channel"
           style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: white;" />

    <!-- Channel Cover -->
    <ImageView fx:id="channelCover" fitHeight="100.0" fitWidth="150.0"
               layoutX="20.0" layoutY="60.0" preserveRatio="true" />

    <!-- Channel Name -->
    <Label layoutX="200.0" layoutY="70.0" text="Name:"
           style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: white;" />
    <Label fx:id="channelName" layoutX="260.0" layoutY="70.0"
           style="-fx-font-size: 16px; -fx-text-fill: white;" />

    <!-- Channel Description -->
    <Label layoutX="200.0" layoutY="100.0" text="Description:"
           style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: white;" />
    <Label fx:id="channelDescription" layoutX="200.0" layoutY="120.0"
           prefHeight="60.0" prefWidth="400.0" wrapText="true"
           style="-fx-font-size: 13px; -fx-text-fill: white;" />

    <!-- Subscriber Count -->
    <Label layoutX="200.0" layoutY="190.0" text="Subscribers:"
           style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: white;" />
    <Label fx:id="subscriberCount" layoutX="310.0" layoutY="190.0"
           style="-fx-font-size: 14px; -fx-text-fill: white;" />

    <!-- New Playlist Button -->
    <Button fx:id="createChannelPlaylistBtn" layoutX="600.0" layoutY="60.0"
            text="➕ New Playlist" onMouseClicked="#onCreateChannelPlaylist"
            style="-fx-background-color: #272727; -fx-text-fill: white;" />

    <!-- Publish Content Button -->
    <Button fx:id="publishContentBtn" layoutX="600.0" layoutY="130.0"
            text="📤Publish Content" onAction="#onPublishContent"
            style="-fx-background-color: #272727; -fx-text-fill: white;" />

    <!-- Playlist Label -->
    <Label layoutX="20.0" layoutY="190.0" text="📂 Playlists:"
           style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: white;" />

    <!-- Playlists List -->
    <ListView fx:id="playlistListView" layoutX="20.0" layoutY="215.0"
              onMouseClicked="#onPlaylistSelected"
              prefHeight="345.0" prefWidth="300.0"
              style="-fx-background-color: #1e1e1e; -fx-control-inner-background: #1e1e1e; -fx-text-fill: white;" />

</AnchorPane>
