<?import javafx.scene.text.Font?>


<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.youtube_graphic.PremiumPackagesPanel">
   <children>
      <GridPane layoutX="61.0" layoutY="78.0" prefHeight="214.0" prefWidth="474.0">
        <columnConstraints>
            <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
          <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
          <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
        </columnConstraints>
        <rowConstraints>
            <RowConstraints maxHeight="205.60002746582032" minHeight="10.0" prefHeight="191.99998779296874" vgrow="SOMETIMES" />
          <RowConstraints maxHeight="113.59998168945313" minHeight="10.0" prefHeight="37.600012207031256" vgrow="SOMETIMES" />
        </rowConstraints>
         <children>
            <ImageView fitHeight="184.0" fitWidth="157.0" GridPane.columnIndex="1">
               <image>
                  <Image url="@../../../Images/silver.jpg" />
               </image>
            </ImageView>
            <ImageView fitHeight="184.0" fitWidth="158.0" GridPane.columnIndex="2">
               <image>
                  <Image url="@../../../Images/gold.jpg" />
               </image>
            </ImageView>
            <ImageView fitHeight="184.0" fitWidth="157.0">
