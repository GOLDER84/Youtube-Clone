      </Label>
      <Button fx:id="buyBtn" layoutX="231.0" layoutY="331.0" mnemonicParsing="false" onMouseClicked="#buyClicked" text="Buy" />
      <Button fx:id="backBtn" layoutX="329.0" layoutY="331.0" mnemonicParsing="false" onMouseClicked="#backClicked" text="Back" />
