<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.FlowPane?>

<AnchorPane prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="com.example.youtube_graphic.PlaylistContentPanel">
    <children>
        <Label fx:id="playlistNameLabel" layoutX="30.0" layoutY="20.0" style="-fx-font-size: 24px;" text="Playlist Name"/>
        <Button fx:id="addContentBtn" layoutX="600.0" layoutY="20.0" text="Add Content" onMouseClicked="#addContentClicked"/>
        <Button fx:id="backBtn" layoutX="700.0" layoutY="20.0" text="Back" onMouseClicked="#backClicked"/>

        <FlowPane fx:id="contentFlowPane" layoutX="30.0" layoutY="70.0" prefWidth="740.0" prefHeight="500.0" hgap="10" vgap="10"/>
    </children>
</AnchorPane>
